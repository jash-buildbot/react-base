{
  "name": "Resume-Parser",
  "description": "Extracts fields from the input.",
  "parameters": {
    "type": "object",
    "properties": {
      "profile": {
        "type": "object",
        "properties": {
          "heading": { "type": "string" },
          "firstName": { "type": "string" },
          "lastName": { "type": "string" },
          "email": { "type": "string", "format": "email" },
          "phone": { "type": "string" },
          "website": { "$ref": "#/definitions/optionalURI" },
          "photo": { "$ref": "#/definitions/optionalURI" },
          "headline": { "type": "string" },
          "address": {
            "type": "object",
            "properties": {
              "line1": { "type": "string" },
              "line2": { "type": "string" },
              "line3": { "type": "string" }
            },
            "required": ["line1", "line2", "line3"]
          }
        },
        "required": ["heading", "firstName", "lastName", "email", "phone", "website", "photo", "headline", "address"]
      },
      "objective": {
        "type": "object",
        "properties": {
          "enable": { "type": "boolean", "default": true },
          "heading": { "type": "string", "default": "Professional Objective" },
          "body": {
            "description": "The body of the objective section in *markdown*. Intelligently identify and extract this information from the text, adapting to various variations like 'Objective,' 'Summary,' 'Career Goals,' or others, ensuring no relevant information is left behind.",
            "type": "string"
          }
        },
        "required": ["enable", "heading", "body"]
      },
      "video": {
        "type": "object",
        "properties": {
          "heading": { "type": "string" },
          "enable": { "type": "boolean" },
          "url": { "$ref": "#/definitions/optionalURI" }
        },
        "required": ["heading", "enable", "url"]
      },
      "work": {
        "type": "object",
        "properties": {
          "heading": { "type": "string" },
          "enable": { "type": "boolean" },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "enable": { "type": "boolean" },
                "id": { "type": "string" },
                "company": { "type": "string" },
                "position": { "type": "string" },
                "startDate": { "$ref": "#/definitions/optionalDate" },
                "endDate": { "$ref": "#/definitions/optionalDate" },
                "description": { "type": "string" }
              },
              "required": ["enable", "id", "company", "position", "startDate", "endDate", "description"]
            }
          }
        },
        "required": ["heading", "enable", "items"]
      },
      "education": {
        "type": "object",
        "properties": {
          "heading": { "type": "string" },
          "enable": { "type": "boolean" },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "enable": { "type": "boolean" },
                "id": { "type": "string" },
                "institution": { "type": "string" },
                "degree": { "type": "string" },
                "fieldOfStudy": { "type": "string" },
                "graduationDate": { "$ref": "#/definitions/optionalDate" }
              },
              "required": ["enable", "id", "institution", "degree", "fieldOfStudy", "graduationDate"]
            }
          }
        },
        "required": ["heading", "enable", "items"]
      },
      "awards": {
        "type": "object",
        "properties": {
          "heading": { "type": "string" },
          "enable": { "type": "boolean" },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "enable": { "type": "boolean" },
                "id": { "type": "string" },
                "title": { "type": "string" },
                "date": { "$ref": "#/definitions/optionalDate" },
                "description": { "type": "string" }
              },
              "required": ["enable", "id", "title", "date", "description"]
            }
          }
        },
        "required": ["heading", "enable", "items"]
      },
      "certifications": {
        "type": "object",
        "properties": {
          "heading": { "type": "string" },
          "enable": { "type": "boolean" },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "enable": { "type": "boolean" },
                "id": { "type": "string" },
                "name": { "type": "string" },
                "authority": { "type": "string" },
                "date": { "$ref": "#/definitions/optionalDate" }
              },
              "required": ["enable", "id", "name", "authority", "date"]
            }
          }
        },
        "required": ["heading", "enable", "items"]
      },
      "skills": {
        "type": "object",
        "properties": {
          "heading": { "type": "string" },
          "enable": { "type": "boolean" },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "enable": { "type": "boolean" },
                "id": { "type": "string" },
                "name": { "type": "string" },
                "level": { "type": "number" }
              },
              "required": ["enable", "id", "name", "level"]
            }
          }
        },
        "required": ["heading", "enable", "items"]
      },
      "hobbies": {
        "type": "object",
        "properties": {
          "heading": { "type": "string" },
          "enable": { "type": "boolean" },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "enable": { "type": "boolean" },
                "id": { "type": "string" },
                "name": { "type": "string" }
              },
              "required": ["enable", "id", "name"]
            }
          }
        },
        "required": ["heading", "enable", "items"]
      },
      "languages": {
        "type": "object",
        "properties": {
          "heading": { "type": "string" },
          "enable": { "type": "boolean" },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "enable": { "type": "boolean" },
                "id": { "type": "string" },
                "language": { "type": "string" },
                "proficiency": { "type": "string" }
              },
              "required": ["enable", "id", "language", "proficiency"]
            }
          }
        },
        "required": ["heading", "enable", "items"]
      },
      "references": {
        "type": "object",
        "properties": {
          "heading": { "type": "string" },
          "enable": { "type": "boolean" },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "enable": { "type": "boolean" },
                "id": { "type": "string" },
                "name": { "type": "string" },
                "relationship": { "type": "string" },
                "contact": { "type": "string" }
              },
              "required": ["enable", "id", "name", "relationship", "contact"]
            }
          }
        },
        "required": ["heading", "enable", "items"]
      },
      "extras": {
        "type": "object",
        "properties": {
          "heading": { "type": "string" },
          "enable": { "type": "boolean" },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "enable": { "type": "boolean" },
                "id": { "type": "string" },
                "title": { "type": "string" },
                "description": { "type": "string" }
              },
              "required": ["enable", "id", "title", "description"]
            }
          }
        },
        "required": ["heading", "enable", "items"]
      }
    },
    "required": [
      "profile",
      "objective",
      "video",
      "work",
      "education",
      "awards",
      "certifications",
      "skills",
      "hobbies",
      "languages",
      "references",
      "extras"
    ],
    "definitions": {
      "optionalURI": {
        "anyOf": [
          { "type": "string", "format": "uri" },
          { "type": "string", "pattern": "^$" },
          { "type": "string"}
        ]
      },
      "optionalDate": {
        "anyOf": [
          {
            "type": "string",
            "format": "date-time",
            "description": "Date in ISO 8601 format.",
            "examples": ["2024-01-30T09:30:10Z"]
          },
          { "type": "string", "pattern": "^$" }
        ]
      }
    }
  }
}